# ===== GENERAL =====
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-before-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== DATABASE (PostgreSQL + pgvector) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=castravision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/castravision
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/castravision_test
# Optional Docker-only override. Leave empty to use the Compose PostgreSQL service.
DOCKER_DATABASE_URL=
# Optional Docker-only overrides. Leave empty to use the Compose service names.
DOCKER_REDIS_URL=
DOCKER_CELERY_BROKER_URL=
DOCKER_CELERY_RESULT_BACKEND=

# ===== SUPABASE AUTH / DATA API =====
SUPABASE_URL=https://oviqgptccjjdaaqxabwv.supabase.co
# Publishable/anon key may be used by the browser. It is still environment-specific.
SUPABASE_PUBLISHABLE_KEY=
# Service role is backend/Celery only. Never prefix it with VITE_ or commit a value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_HTTP_TIMEOUT_SECONDS=10

# ===== REDIS / CELERY =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===== LLM / RAG =====
# Leave OPENAI_API_KEY empty to use the deterministic Sprint 1 fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
ALLOW_LLM_FALLBACK=true
RAG_TOP_K=5
