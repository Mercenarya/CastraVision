# Copy this file to the repository root as .env. Keep real credentials out of Git.
# Docker Compose reads this same file; Vite only exposes VITE_* variables to browsers.

# Django / API
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Leave DATABASE_URL empty for local SQLite. For local PostgreSQL, use localhost.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=castravision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional test/alternate connection strings used by local scripts.
TEST_DATABASE_URL=
DOCKER_DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_CELERY_BROKER_URL=redis://redis:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis:6379/1

# Frontend (Vite reads these from this root file; only VITE_* is browser-visible)
VITE_API_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend / scripts
SUPABASE_URL=
# SUPABASE_KEY is retained for the legacy Utils.supabase_client module.
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_HTTP_TIMEOUT_SECONDS=10

# LLM / RAG
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
ALLOW_LLM_FALLBACK=true
RAG_TOP_K=5

# Meta / Facebook Ads (optional)
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=

# Google Ads (optional; OAuth client JSON remains a separate local credential file)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# Optional Supabase CLI / deployment secrets (used by supabase/config.toml)
SENDGRID_API_KEY=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
