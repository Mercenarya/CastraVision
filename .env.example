# ===== GENERAL =====
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-before-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== DATABASE (PostgreSQL + pgvector) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=castravision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/castravision
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/castravision_test

# ===== SUPABASE DATA API (backend-only verification) =====
SUPABASE_URL=https://oviqgptccjjdaaqxabwv.supabase.co
SUPABASE_SECRET_KEY=

# ===== REDIS / CELERY =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===== LLM / RAG =====
# Leave OPENAI_API_KEY empty to use the deterministic Sprint 1 fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
ALLOW_LLM_FALLBACK=true
RAG_TOP_K=5
